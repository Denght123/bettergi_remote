[Unit]
Description=BetterGI Remote Lite relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bettergi-remote-lite
Group=bettergi-remote-lite
WorkingDirectory=/opt/bettergi-remote-lite
Environment=PORT=8080
Environment=LISTEN_ADDRESS=127.0.0.1:8080
Environment=WEB_ROOT=/opt/bettergi-remote-lite/web
Environment=UPDATE_ROOT=/opt/bettergi-remote-lite/downloads
Environment=ALLOWED_ORIGIN=https://bgiremote.163831.xyz
ExecStart=/opt/bettergi-remote-lite/relay
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
